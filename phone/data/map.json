  "points": [
    { "id": "home", "cat": "home", "name": "锦绣云湾", "lon": 121.400, "lat": 31.070, "major": true, "desc": "20 层顶楼复式 2001，六个房间，一台永远在争夺的空调遥控器。", "who": "home", "go": "我回锦绣云湾。", "floor": true },
    { "id": "lawson", "cat": "store", "name": "罗森便利店", "lon": 121.410, "lat": 31.060, "desc": "公寓楼下的罗森。某位神明暗示过：多来看看，能捡到好东西。", "go": "我下楼去罗森买点东西。" },
    { "id": "xinzhuang", "cat": "train", "name": "莘庄站", "lon": 121.385, "lat": 31.111, "desc": "1 号线和 5 号线的换乘站，进城必经之路。早高峰能把人挤成照片。", "go": "我去莘庄站坐地铁。" },
    { "id": "mhhosp", "cat": "hosp", "name": "闵行区中心医院", "lon": 121.365, "lat": 31.135, "desc": "离公寓最近的医院。江澜训练扭到脚、周莹春吃撑了，都是来这。", "go": "我去闵行区中心医院。" },
    { "id": "sjtu", "cat": "uni", "name": "上海交通大学", "lon": 121.437, "lat": 31.025, "major": true, "desc": "闵行校区。主角和东方遇晓的学校，文学系在东区，金融系在西区，中间隔着一条永远在修的路。", "who": ["me", "h5"], "go": "我去交大上课。" },
    { "id": "ecnu", "cat": "uni", "name": "华东师大", "lon": 121.458, "lat": 31.040, "desc": "闵行校区，就在交大隔壁。两校学生共享一条小吃街。", "go": "我去华师那边的小吃街转转。" },
    { "id": "qibao", "cat": "food", "name": "七宝古镇", "lon": 121.351, "lat": 31.155, "desc": "离公寓最近的老街。臭豆腐、汤团、糖藕一条街吃过去，周莹春能从街头吃到街尾。", "go": "我们去七宝古镇吃东西。" },
    { "id": "necc", "cat": "fun", "name": "国家会展中心", "lon": 121.300, "lat": 31.190, "desc": "四叶草。漫展季叶潇雨会在这里出 cos，顺便把主角抓去当苦力搬箱子。", "go": "我陪叶潇雨去漫展。", "event": "comicon_ye" },
    { "id": "hongqiao", "cat": "train", "name": "虹桥站", "lon": 121.322, "lat": 31.205, "desc": "高铁和机场都在这。回北京、回四川、回广东，都从这里出发。", "go": "我去虹桥站。" },
    { "id": "xujiahui", "cat": "shop", "name": "徐家汇", "lon": 121.437, "lat": 31.195, "desc": "商场一个连一个，天主教堂就在旁边。东方遇晓嫌这里「太挤」，但每次都买得最多。", "go": "我们去徐家汇逛街。" },
    { "id": "sta", "cat": "uni", "name": "上海戏剧学院", "lon": 121.446, "lat": 31.222, "major": true, "desc": "华山路校区。柳轻飏的学校，舞蹈系排练厅的镜子墙上贴着她偷拍的全体室友合照。", "who": ["h4"], "go": "我去上戏找柳轻飏。" },
    { "id": "yongkang", "cat": "bar", "name": "永康路酒吧街", "lon": 121.455, "lat": 31.207, "desc": "梧桐树下一整条小酒馆。叶潇雨的地盘，酒品极差的她在这里喝断片过不止一次。", "go": "我们去永康路喝一杯。" },
    { "id": "xintiandi", "cat": "food", "name": "新天地", "lon": 121.475, "lat": 31.219, "desc": "石库门改的餐厅和咖啡馆。约会圣地，也是东方遇晓「顺路」带人来吃下午茶的地方。", "go": "我们去新天地吃饭。" },
    { "id": "nanjing", "cat": "shop", "name": "南京路步行街", "lon": 121.476, "lat": 31.236, "desc": "逛街圣地。柳轻飏买美甲、东方遇晓买裙子、江澜买护膝，分头行动半小时后在第一食品门口集合。", "go": "我们去南京路逛逛。" },
    { "id": "shstation", "cat": "train", "name": "上海站", "lon": 121.456, "lat": 31.250, "desc": "老火车站。周莹春第一次来上海就是从这里下的车，拎着一蛇皮袋的家乡特产。", "go": "我去上海站接人。" },
    { "id": "bund", "cat": "sight", "name": "外滩", "lon": 121.490, "lat": 31.240, "major": true, "desc": "江风、万国建筑、人挤人。东方遇晓说这里是「外地人才来的地方」，但她小时候的照片全在这拍的。", "go": "我们去外滩走走。", "event": "dong_date_bund" },
    { "id": "yuyuan", "cat": "sight", "name": "豫园", "lon": 121.492, "lat": 31.227, "desc": "九曲桥、城隍庙、南翔小笼。外地亲戚来上海的固定行程。", "go": "我们去豫园。" },
    { "id": "pearl", "cat": "sight", "name": "东方明珠", "lon": 121.502, "lat": 31.240, "desc": "陆家嘴的地标。在江对岸看最漂亮，真上去了反而只能看见别的楼。", "go": "我们去陆家嘴看东方明珠。" },
    { "id": "century", "cat": "park", "name": "世纪公园", "lon": 121.551, "lat": 31.216, "desc": "浦东最大的公园。江澜周末晨跑的路线，柳轻飏在草坪上拍舞蹈视频。", "go": "我们去世纪公园。" },
    { "id": "fudan", "cat": "uni", "name": "复旦大学", "lon": 121.503, "lat": 31.297, "major": true, "desc": "邯郸校区。陈霜月和周莹春在这里，食堂的红烧肉是周莹春的精神支柱。", "who": ["h1", "h3"], "go": "我去复旦找人。" },
    { "id": "sus", "cat": "uni", "name": "上海体育大学", "lon": 121.522, "lat": 31.313, "major": true, "desc": "江澜的主场。操场、健身房、游泳馆，她一天能跑三个来回。", "who": ["h2"], "go": "我去上体找江澜。" },
    { "id": "wujiaochang", "cat": "shop", "name": "五角场", "lon": 121.516, "lat": 31.300, "desc": "杨浦的商圈，复旦和上体的学生都在这吃饭逛街。", "go": "我们去五角场。" },
    { "id": "disney", "cat": "fun", "name": "上海迪士尼", "lon": 121.667, "lat": 31.144, "major": true, "desc": "门票很贵。但烟花下的那一幕，值得。", "go": "我们去迪士尼！", "event": "disney_date" }
  ],
